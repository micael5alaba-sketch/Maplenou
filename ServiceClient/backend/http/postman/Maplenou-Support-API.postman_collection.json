        {
          "name": "Create a ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"ticketId\", t.id);",
                  "pm.collectionVariables.set(\"ticketNumber\", t.ticketNumber);",
                  "pm.test(\"number TKT-…\", () => pm.expect(t.ticketNumber).to.match(/^TKT-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/support/tickets",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeanToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Colis non reçu\",\n  \"description\": \"Ma commande est marquée livrée mais je n'ai rien reçu.\",\n  \"categoryCode\": \"DELIVERY\",\n  \"priority\": \"HIGH\",\n  \"urgent\": false\n}"
            }
          }
        },
