    {
      "name": "6 · Push notifications (Firebase)",
      "description": "Without a Firebase key the server runs in log-only mode: the test push is accepted and written to the backend log. With FIREBASE_CREDENTIALS_FILE set, mode is firebase; register a real browser token (web app > Notifications > Turn on) to receive it.",
      "item": [
        {
          "name": "Push channel and my devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mode\", () => pm.expect([\"firebase\", \"log-only\"]).to.include(pm.response.json().mode));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/support/notifications/push-status",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jeanToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Register a device token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"deviceToken\", \"postman-\" + Date.now());"
                ]
              }
            }
