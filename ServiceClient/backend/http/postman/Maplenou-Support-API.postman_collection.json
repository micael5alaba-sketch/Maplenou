          "name": "Critical priority is refused (422, BR-036)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"problem code CRITICAL_PRIORITY_RESERVED\", () => pm.expect(pm.response.json().code).to.eql(\"CRITICAL_PRIORITY_RESERVED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
