#!/bin/sh
# Sourced by the nginx image entrypoint before it renders /etc/nginx/templates/*.template (see nginx.conf.template).
# Defaults keep the Docker Compose behaviour; Render sets ASSISTANT_UPSTREAM to the assistant's public URL.
: "${ASSISTANT_UPSTREAM:=http://assistant:8000}"
if [ -z "${DOCS_RESOLVER:-}" ]; then
    DOCS_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)
    case "$DOCS_RESOLVER" in
        "") DOCS_RESOLVER=127.0.0.11 ;;
        *:*) DOCS_RESOLVER="[$DOCS_RESOLVER]" ;;   # IPv6 address: nginx needs brackets
    esac
fi
export ASSISTANT_UPSTREAM DOCS_RESOLVER
