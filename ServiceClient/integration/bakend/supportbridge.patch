+++ b/Bakend/src/main/resources/application.properties
@@ -250,3 +250,13 @@ springdoc.api-docs.path=/v3/api-docs
 springdoc.api-docs.enabled=${SWAGGER_ENABLED:true}
 # Active ou desactive la page web interactive Swagger UI (meme logique que ci-dessus).
 springdoc.swagger-ui.enabled=${SWAGGER_ENABLED:true}
+
+# ---------------------------------------------------------------- Pont vers le Service client (ServiceClient/)
+# Jeton partagé avec ServiceClient (SUPPORT_SERVICE_TOKEN des deux côtés, 32 caractères aléatoires au moins).
+# Vide = API interne /internal/v1/** désactivée (404). Ne jamais exposer /internal/ sur Internet.
+app.support-bridge.token=${SUPPORT_SERVICE_TOKEN:}
+# Compte ADMIN qui signe les messages envoyés aux livreurs depuis un ticket ; vide = le plus ancien admin actif.
+app.support-bridge.sender-user-id=${SUPPORT_SENDER_USER_ID:}
+# Passage au service client : true = la page admin des anciens tickets devient consultation seule (ServiceClient
+# les importe et suit leurs changements avec LEGACY_SYNC_ENABLED=true). Voir MANUEL.md (service client).
+app.support.legacy-read-only=${SUPPORT_LEGACY_READ_ONLY:false}
