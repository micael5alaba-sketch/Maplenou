# Configuration of docker-compose.yml and docker-compose.test.yml.
# Copy to .env (git-ignored) and adjust:   cp .env.example .env   (Windows: copy .env.example .env)
# Every value below is used by the compose files; nothing is hard-coded there.

# ---------------------------------------------------------------- Docker project name
# Names the containers and the data volumes (database, attachments). Keep this value to reuse the tickets and
# attachments created when this module lived in the folder "maplenou-service-client-governance".
COMPOSE_PROJECT_NAME=maplenou-service-client-governance

# ---------------------------------------------------------------- host ports (change one if "port is already allocated")
# 3000 and 8080 are used by the Maplenou admin back-office and Bakend (repository root, DEMARRAGE.md)
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8081
DOCS_HOST_PORT=8006
# only used by docker-compose.override.yml (copy of docker-compose.override.example.yml)
POSTGRES_HOST_PORT=5433
# Network address the ports above listen on: 127.0.0.1 = this computer only (recommended, also on a server where
# the public profile's Caddy is the entry point) | 0.0.0.0 = every network of the computer
HOST_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------- database
POSTGRES_DB=maplenou_support
POSTGRES_USER=maplenou
# Change outside local demos
POSTGRES_PASSWORD=maplenou

# ---------------------------------------------------------------- backend
# "demo" = demo login + sample orders/deliveries + seeded tickets. NEVER use demo in production.
# With real Maplenou accounts (below): SPRING_PROFILES_ACTIVE=default
SPRING_PROFILES_ACTIVE=demo
# Signs the support service's own tokens. At least 32 characters (openssl rand -hex 32). Change outside local demos.
JWT_SECRET=demo-only-secret-change-me-0123456789abcdef
CORS_ALLOWED_ORIGINS=http://localhost:3001
# SLA clock: always = 24/7, weekends and public holidays count | business-hours = Mon–Fri 08:00–18:00 minus holidays
SLA_MODE=always

# ---------------------------------------------------------------- Maplenou platform (Bakend) — docs/guide/maplenou-integration.md
# Bakend as seen from the containers (it runs on the computer with Bakend/start-all.ps1, port 8080)
MAPLENOU_CORE_URL=http://host.docker.internal:8080
# true = sign in with the Maplenou account (phone + password); then set AUTH_MODE=maplenou too
MAPLENOU_LOGIN_ENABLED=false
# Sign-in page of the web app: demo (personas) | maplenou (Maplenou account)
AUTH_MODE=demo
# true behind HTTPS (public deployment): the session cookie is then sent over HTTPS only
SESSION_COOKIE_SECURE=false
# demo (sample orders) | http (real orders/deliveries read from Bakend /internal/v1, needs the token below)
ECOSYSTEM_MODE=demo
# Shared secret with Bakend (same value in Bakend's SUPPORT_SERVICE_TOKEN), 32+ random characters.
# Needed by ECOSYSTEM_MODE=http and by the import of the former tickets. Empty = not connected.
SUPPORT_SERVICE_TOKEN=
# ---------------------------------------------------------------- Firebase push notifications (docs/guide/firebase.md)
# Service-account key: save it as secrets/firebase-service-account.json (folder mounted read-only), then set
#   FIREBASE_CREDENTIALS_FILE=/run/secrets/maplenou/firebase-service-account.json
# Empty = push notifications are only written to the backend log.
FIREBASE_CREDENTIALS_FILE=
# Web app of Maplenou's Firebase project maplenou-c21c2 (public values, same as frontend/lib/firebase_options.dart).
# Browser push starts once FIREBASE_WEB_VAPID_KEY is set: Firebase console > Project settings > Cloud Messaging >
# Web Push certificates > Generate key pair (public key). Any value empty = no push in the browser.
FIREBASE_WEB_API_KEY=AIzaSyAfY8hXrj_7V7v926bpWuJY6_ycXtr3II4
FIREBASE_WEB_AUTH_DOMAIN=maplenou-c21c2.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=maplenou-c21c2
FIREBASE_WEB_MESSAGING_SENDER_ID=833530565751
FIREBASE_WEB_APP_ID=1:833530565751:web:4bb53f36ab5571a2ac2272
FIREBASE_WEB_VAPID_KEY=

# Push to the Maplenou mobile app through Bakend (it holds the app's FCM tokens): true needs SUPPORT_SERVICE_TOKEN
MAPLENOU_PUSH_RELAY=false
# Address of this web app as users see it (push notifications link to <SUPPORT_APP_URL>/?ticket=<id>).
# Public deployment: https://<SUPPORT_DOMAIN>
SUPPORT_APP_URL=http://localhost:3001

# ---------------------------------------------------------------- tickets
# A resolved ticket closes by itself after this ISO-8601 duration if the requester does not reopen it (P0D = never)
SUPPORT_AUTO_CLOSE_AFTER=P7D
# Former Maplenou support module (Bakend, numbers SUP-/TKT-…) still used by the Flutter app (DEC-CS12-02):
# true = import its new tickets and note its status changes every LEGACY_SYNC_INTERVAL (needs MAPLENOU_CORE_URL and
# SUPPORT_SERVICE_TOKEN). Set SUPPORT_LEGACY_READ_ONLY=true on Bakend so a ticket is never handled in both places.
LEGACY_SYNC_ENABLED=false
LEGACY_SYNC_INTERVAL=PT15M

# ---------------------------------------------------------------- attachments (docs/guide/attachments.md)
# local = Docker volume "attachments" | cloudinary = private files on Cloudinary (authenticated delivery)
ATTACHMENT_STORAGE=local
# Secret (Cloudinary console > API keys): cloudinary://<api_key>:<api_secret>@<cloud_name> — empty with local
CLOUDINARY_URL=
CLOUDINARY_FOLDER=maplenou-support
# none | clamav = every file is scanned by ClamAV before it is stored (start with --profile antivirus)
ANTIVIRUS=none
# true = refuse uploads while ClamAV cannot be reached (safer); false = accept them unscanned
ANTIVIRUS_FAIL_CLOSED=true
# Antivirus container (--profile antivirus only)
CLAMAV_IMAGE=clamav/clamav:1.4.3

# ---------------------------------------------------------------- protection and observability (docs/guide/operations.md)
# Requests per minute and per signed-in user (or address): above, the API answers 429 Too Many Requests
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60
# none = ignore X-Forwarded-For | native = trust it from the Docker network (public profile, behind Caddy)
FORWARD_HEADERS_STRATEGY=none
# empty = readable text logs | ecs = one JSON object per line (central log tools: Loki, Elastic, Datadog…)
LOG_FORMAT=
# Bearer token Prometheus uses for /actuator/prometheus (24+ random characters). Empty = no metrics endpoint.
# Required by --profile monitoring.
METRICS_TOKEN=
# Monitoring profile (--profile monitoring): Prometheus with alert rules (monitoring/alerts.yml) and Grafana
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PROMETHEUS_RETENTION=15d
GRAFANA_IMAGE=grafana/grafana:12.1.1
GRAFANA_HOST_PORT=3003
# Change it before starting the monitoring profile (Grafana login: admin / this password)
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------------------------------------------------------------- AI help inside tickets (needs --profile docs)
# true = the assistant suggests a category and a priority for new tickets and drafts replies for the agents.
# Nothing is applied or sent without an agent. Only the subject, description and public messages are sent.
AI_ASSIST_ENABLED=false
# Shared secret between the backend and the assistant (24+ random characters); empty = AI help off
ASSISTANT_INTERNAL_TOKEN=

# ---------------------------------------------------------------- backend cache
# How long reference data (categories, business calendar) stays in the backend cache (ISO-8601 duration)
REFERENCE_CACHE_TTL=PT10M

# ---------------------------------------------------------------- documentation and assistant (docs profile)
DOCS_PUBLIC_URL=http://localhost:8006
# Sites built into the docs image. Public deployment: DOCS_SITES=user and ASSISTANT_SITES=user
DOCS_SITES=user,staff,developer
ASSISTANT_SITES=user,staff,developer
# ---------------------------------------------------------------- language model of the assistant (Ollama)
# Default: Ollama cloud — nothing to install, no model on the disk. Create a free account on https://ollama.com,
# then a key at https://ollama.com/settings/keys and paste it below (secret: .env is never committed).
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
# A model of the free plan (list: https://ollama.com/api/tags)
ASSISTANT_CHAT_MODEL=gpt-oss:20b
# Ollama cloud serves chat models: leave empty = search by keywords (BM25), no embeddings
ASSISTANT_EMBED_MODEL=
# Reasoning effort of gpt-oss models (low = faster answers); empty for models without "thinking"
ASSISTANT_THINK=low
# questions per minute and per visitor
ASSISTANT_RATE_LIMIT=20
# answer cache: entries kept in memory and their lifetime in seconds (0 entries = disabled)
ASSISTANT_ANSWER_CACHE_SIZE=256
ASSISTANT_ANSWER_CACHE_TTL=3600
# Local Ollama instead (computer: http://host.docker.internal:11434, container: http://ollama:11434 with
# --profile ollama): OLLAMA_API_KEY= , ASSISTANT_CHAT_MODEL=qwen2.5:3b, ASSISTANT_EMBED_MODEL=nomic-embed-text,
# ASSISTANT_THINK= and ASSISTANT_PULL_MODELS=true (downloads about 2.3 GB once).
ASSISTANT_PULL_MODELS=false
# Optional: profiles started by a plain "docker compose up" (e.g. docs, or docs,ollama for the container)
# COMPOSE_PROFILES=docs
# Ollama container only (--profile ollama). Pin a version for reproducible deployments, e.g. ollama/ollama:<version>
OLLAMA_IMAGE=ollama/ollama:latest
# Unload a model from memory after this idle time (frees RAM between questions)
OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------- public deployment (--profile public, docs/guide/deployment.md)
# Domain names (DNS A/AAAA records pointing to the server). Caddy gets the HTTPS certificates by itself.
# Example: support.maplenou.tg (web app), aide.maplenou.tg (help centre + assistant), www.maplenou.tg (site)
SUPPORT_DOMAIN=support.example.com
HELP_DOMAIN=aide.example.com
SITE_DOMAIN=www.example.com
# Let's Encrypt account e-mail (expiry warnings)
ACME_EMAIL=admin@example.com
CADDY_IMAGE=caddy:2.10.0-alpine
# Links of the public site (empty = button hidden)
MAPLENOU_APP_URL=
ANDROID_APP_URL=
IOS_APP_URL=

# ---------------------------------------------------------------- container logs (rotation, per container)
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ---------------------------------------------------------------- test stack (docker-compose.test.yml, in-memory database)
TEST_POSTGRES_DB=maplenou_test
TEST_POSTGRES_USER=maplenou
TEST_POSTGRES_PASSWORD=maplenou
