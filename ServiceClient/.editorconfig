# Same formatting in every editor (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,py}]
indent_size = 4

[*.{md,markdown}]
# two trailing spaces are a Markdown line break
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.{ps1,cmd,bat}]
end_of_line = crlf
indent_size = 4
