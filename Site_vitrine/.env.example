# Configuration of the public website (docker-compose.yml and "npm run dev/start").
# Copy to .env (git-ignored):   cp .env.example .env   (Windows: copy .env.example .env)

# Host port of the site (3000 = admin back-office, 3001 = customer service, 8080 = Bakend, 8006 = help centre)
SITE_HOST_PORT=3002
# Public address of this site (links in search engines and social previews)
SITE_PUBLIC_URL=http://localhost:3002

# Maplenou API (Bakend) as seen by the site server: public catalogue (categories, products, delivery prices).
# Docker: http://host.docker.internal:8080 — without Docker (npm run dev): http://localhost:8080
# If it does not answer, the pages still show their static content.
MAPLENOU_API_URL=http://host.docker.internal:8080

# Where "Open the app" leads (Maplenou web app or store page). Empty = the button is hidden.
APP_URL=
# Store pages of the mobile app. Empty = hidden.
ANDROID_APP_URL=
IOS_APP_URL=

# Customer service (ServiceClient): web app to open a ticket, and the public help centre (user guide)
SERVICE_CLIENT_URL=http://localhost:3001
HELP_CENTER_URL=http://localhost:8006/user/fr/

# Social networks of Maplenou (full https:// links). Empty = not shown; the "Follow Maplenou" block is hidden when
# all are empty.
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_WHATSAPP_URL=
SOCIAL_X_URL=
SOCIAL_YOUTUBE_URL=

# Container logs (rotation)
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
